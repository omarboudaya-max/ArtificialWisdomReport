# --- Supabase (required for the workspace) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional ---
# Reference sandbox model + Compliance Copilot (Groq)
GROQ_API_KEY=
COPILOT_MODEL=llama-3.3-70b-versatile
# Canonical site URL for metadata
NEXT_PUBLIC_SITE_URL=https://www.auditingartificialwisdom.com
# Shown on pricing "Contact us" buttons
NEXT_PUBLIC_CONTACT_EMAIL=

# Local development only: allow scanning localhost / private hosts (ignored in production)
# AW_ALLOW_PRIVATE_HOSTS=1
